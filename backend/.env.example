# Copy this file to .env and fill in your own values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbon_credit_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Server
PORT=3001

# JWT — use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Optional
# APP_URL=http://localhost:3001          # base address used in e-mail links
# UPLOAD_DIR=./uploads/kyc               # where KYC documents are stored
# ORDER_EXPIRY_INTERVAL_MS=60000         # how often expired orders are closed
# RATE_LIMIT_MAX=200                     # API requests per 15 minutes
# AUTH_RATE_LIMIT_MAX=20                 # login attempts per 15 minutes
# MAIL_LOG=off                           # stop printing e-mails to the console
# NODE_ENV=production                    # hides the dev verification link
